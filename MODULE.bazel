"""
Ownkit Bazel Module
Personal development tools monorepo

Go version is managed via go.mod and loaded at configuration time.
Bazel env manages global toolchain dependencies.
"""

module(
    name = "ownkit",
    version = "0.1.0",
    compatibility_level = 1,
)

###############################################################################
# Core build rules
###############################################################################

bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.47.0", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_shell", version = "0.6.1")

###############################################################################
# Development dependencies
###############################################################################

# bazel_env manages toolchain dependencies (Go, etc.) from go.mod
bazel_dep(name = "bazel_env.bzl", version = "0.5.0", dev_dependency = True)

###############################################################################
# Go SDK Configuration
###############################################################################

# Go version 1.25.3 is specified in go.mod
# We download an SDK for the host OS/architecture and common remote platforms
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(name = "go_sdk", version = "1.25.3")
use_repo(go_sdk, "go_sdk")

###############################################################################
# Go Dependencies from go.mod
###############################################################################

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Note: When adding Go dependencies, you'll need to add them to use_repo()
# Run 'bazel mod tidy' to automatically update this section

###############################################################################
# Toolchain Registration
###############################################################################

register_toolchains("@go_sdk//:all")
